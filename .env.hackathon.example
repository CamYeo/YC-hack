# APPRENTICE hackathon-only configuration.
# Copy to .env.hackathon.local (gitignored) and fill in ONLY credentials issued for this hackathon.
# The app reads exactly that file. It never falls back to OPENAI_API_KEY, ELEVENLABS_API_KEY,
# or any other variable inherited from your shell.
#
# APP_MODE=live    every provider must be configured; startup is refused otherwise (missing names are listed).
# APP_MODE=fixture providers without complete credentials use clearly labelled fixtures
#                  (scripted reasoning, browser speech). Each provider's real mode is shown in the UI.
APP_MODE=fixture

# OpenAI: reasoning workers (facilitator, Maya, Theo, evidence summaries, reflection)
HACKATHON_OPENAI_API_KEY=
HACKATHON_OPENAI_MODEL=
# Optional: minimal | low | medium. Only sent for reasoning models; leave blank otherwise.
HACKATHON_OPENAI_REASONING_EFFORT=
# Optional: reuse the first three untouched SWE turns generated by OpenAI; later/human replies stay live.
HACKATHON_CACHE_OPENING=false

# ElevenLabs: three AI voices + live transcription (stock or library IDs permitted by this account)
HACKATHON_ELEVENLABS_API_KEY=
HACKATHON_VOICE_FACILITATOR=
HACKATHON_VOICE_MAYA=
HACKATHON_VOICE_THEO=
HACKATHON_TTS_MODEL=eleven_flash_v2_5
# Optional character overrides: smoother library voices, prepared/cached for the demo.
HACKATHON_TTS_MODEL_FACILITATOR=eleven_multilingual_v2
HACKATHON_TTS_MODEL_THEO=eleven_multilingual_v2
HACKATHON_STT_MODEL=scribe_v2_realtime

# Agent Relay / Relaycast. Leave the key blank to use the workspace minted by `bun run relay:bootstrap`
# (stored in .local/relay-workspace.json with owner-only permissions).
HACKATHON_RELAY_BASE_URL=https://armadillo.agentrelay.com/v1
HACKATHON_RELAY_WORKSPACE_KEY=

# Terse local runtime (no hosted API key needed for local development)
TERSE_LOCAL_URL=http://127.0.0.1:7100/v1/projects/local/actors
